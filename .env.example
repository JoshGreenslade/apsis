# Use a persistent disk in production. Node.js 24+ is required for node:sqlite.
CURRICULUM_DB_PATH=.data/mastery.sqlite
# Set when deployed behind an HTTPS reverse proxy, e.g. https://learn.example.com
# APP_ORIGIN=https://learn.example.com

# Optional: enables AI-selected practice variations via the Responses API.
# Keep these server-side. Choose a model available to your account that supports
# structured outputs. With either unset, checked-template practice still works.
# OPENAI_API_KEY=
# OPENAI_MODEL=
